{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Backend",
      "preLaunchTask": "npm: start backend",
      "console": "integratedTerminal",
      "runtimeArgs": ["-r", "ts-node/register"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Frontend",
      "preLaunchTask": "npm: start frontend",
      "console": "integratedTerminal",
      "runtimeArgs": ["-r", "ts-node/register"]
    }
  ],
  "compounds": [
    {
      "name": "Launch",
      "configurations": [
        "Launch Backend",
        "Launch Frontend"
      ],
      "preLaunchTask": "docker-compose up"
    }
  ]
}